import numpy as np
import random

# 1. Take User Input for Parameters
try:
    num_cities = int(input("Enter the number of cities (e.g., 10): "))
    pop_size = int(input("Enter population size (e.g., 50): "))
    generations = int(input("Enter number of generations (e.g., 200): "))
except ValueError:
    print("\n[Invalid Input] Using defaults: 10 cities, 50 population, 200 generations.")
    num_cities, pop_size, generations = 10, 50, 200

# 2. Setup Problem Data (Random Coordinates based on user input)
random.seed(42) 
cities = {i: (random.randint(0, 100), random.randint(0, 100)) for i in range(num_cities)}

# 3. Distance Matrix Calculation
dist_matrix = np.zeros((num_cities, num_cities))
for i in range(num_cities):
    for j in range(num_cities):
        dist_matrix[i][j] = np.linalg.norm(np.array(cities[i]) - np.array(cities[j]))

# 4. Fitness Function: 1 / Total Route Distance
def get_fitness(route):
    distance = sum(dist_matrix[route[i]][route[i+1]] for i in range(len(route)-1))
    distance += dist_matrix[route[-1]][route[0]] # Return to start city
    return 1.0 / distance, distance

# 5. Genetic Operators
def crossover(p1, p2):
    # Ordered Crossover (OX) to prevent duplicate cities
    a, b = sorted(random.sample(range(num_cities), 2))
    child = [None] * num_cities
    child[a:b] = p1[a:b]
    
    pointer = 0
    for city in p2:
        if city not in child:
            while child[pointer] is not None:
                pointer += 1
            child[pointer] = city
    return child

def mutate(route, mutation_rate=0.1):
    # Swap Mutation
    if random.random() < mutation_rate:
        i, j = random.sample(range(num_cities), 2)
        route[i], route[j] = route[j], route[i]

def tournament_selection(pop, k=5):
    # Explicitly check index [0] to extract the fitness value correctly
    selected = random.sample(pop, min(k, len(pop)))
    return max(selected, key=lambda x: get_fitness(x)[0])

# 6. Main Genetic Algorithm Loop
def genetic_algorithm(p_size, gens):
    # Initialize Population
    population = [random.sample(range(num_cities), num_cities) for _ in range(p_size)]
    
    for gen in range(gens):
        new_pop = []
        # Keep the absolute best individual (Elitism) - explicitly checking index [0]
        best_ind = max(population, key=lambda x: get_fitness(x)[0])
        new_pop.append(best_ind)
        
        while len(new_pop) < p_size:
            parent1 = tournament_selection(population)
            parent2 = tournament_selection(population)
            child = crossover(parent1, parent2)
            mutate(child)
            new_pop.append(child)
            
        population = new_pop

    # Get final best route - explicitly checking index [0]
    best_route = max(population, key=lambda x: get_fitness(x)[0])
    _, final_dist = get_fitness(best_route)
    return best_route, final_dist

# Run and Print Results
print("\nRunning Genetic Algorithm...")
best_route, best_distance = genetic_algorithm(pop_size, generations)
print(f"\nBest Route Found: {best_route}")
print(f"Shortest Distance: {best_distance:.2f}")
